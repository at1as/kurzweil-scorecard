{
  "name": "kurzweil-scorecard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "data:import": "python3 scripts/extract-workbook.py && tsx scripts/import-data.ts",
    "data:validate": "python3 kurzweil_verification_v0_3_package/validate_v03.py && tsx scripts/validate-data.ts",
    "prebuild": "npm run data:import",
    "build": "next build",
    "preview": "node scripts/serve.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run data:validate && npm run typecheck && npm test",
    "test:browser": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.{ts,mjs}\" \"tests/**/*.ts\" \"*.{ts,mts,mjs,json}\" README.md docs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tanstack/react-table": "8.21.3",
    "csv-parse": "^7.0.3",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
